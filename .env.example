# =============================================================================
#  IKI Salesforce Product MCP — environment variables
#  Copy to .env.local for local dev. NEVER commit real secrets.
#  In production these are set via `vercel env add` (do not paste them here).
# =============================================================================

# --- Salesforce (Client Credentials flow via an External Client App) ---------

# The org's My Domain URL — NOT login.salesforce.com.
# e.g. https://iki.my.salesforce.com
SF_LOGIN_URL=""

# Consumer Key / Consumer Secret from the External Client App (ECA).
# The secret is revealed after email verification in Salesforce Setup.
#
# The ECA's Client Credentials "Run As" user needs Create + Edit object
# permissions on Product2 (and field-level security on any custom fields you
# intend to write) — grant this via a Permission Set in Salesforce Setup.
# This can be the SAME ECA as the read-only sibling server, or a dedicated one
# — either way, use a DIFFERENT MCP_BEARER_TOKEN below than that server's.
SF_CLIENT_ID=""
SF_CLIENT_SECRET=""

# --- MCP transport auth (Claude -> this server) ------------------------------

# Shared bearer token that guards the public MCP endpoint. This is the only
# thing protecting a public URL that can WRITE CRM data — treat it as at
# least as sensitive as a database credential, and keep it distinct from the
# read-only server's token so the two can be rotated independently.
# Generate one with:  openssl rand -hex 32
MCP_BEARER_TOKEN=""
